{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npx expo *)",
      "Bash(supabase *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Read(*)",
      "Edit(apps/**)",
      "Edit(packages/**)",
      "Edit(supabase/**)",
      "Edit(.claude/**)",
      "Write(apps/**)",
      "Write(packages/**)",
      "Write(supabase/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.p8)",
      "Read(**/service-account*.json)",
      "Edit(docs/**)",
      "Bash(git push --force*)",
      "Bash(rm -rf *)",
      "Bash(supabase db reset --linked*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/post-edit.mjs",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm -s check:fast",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "env": {
    "EXPO_PUBLIC_ENV": "development",
    "EXPO_PUBLIC_SKIP_AUTH": "1"
  }
}
